# Hanya untuk development (`go run .`). Di server, install.sh menulis /etc/wmail/wmail.env.
# API key & setting lain disimpan di database: `wmail config set <key>` atau halaman Pengaturan.
PORT=8080
DB_PATH=./data/mail.db
# PostgreSQL sebagai ganti SQLite (opsional; server di mesin lain wajib ?sslmode=verify-full):
# DATABASE_URL=postgres://user:password@localhost:5432/wmail
DATA_DIR=./data/attachments
